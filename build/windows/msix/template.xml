<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kutex"
        Arguments=""
        InstallLocation="C:\Program Files\Khudo-R\kutex">
    </Installer>
    <PackageInformation
        PackageName="kutex"
        PackageDisplayName="kutex"
        PublisherName="CN=Khudo-R"
        PublisherDisplayName="Khudo-R"
        Version="0.0.1.0"
        PackageDescription="Desktop terminal emulator built with Go and Wails">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wails.kutex"
                Description="Desktop terminal emulator built with Go and Wails"
                DisplayName="kutex"
                ExecutableName="kutex"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>kutex</DisplayName>
            <PublisherDisplayName>Khudo-R</PublisherDisplayName>
            <Description>Desktop terminal emulator built with Go and Wails</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kutex.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
